{
  "name": "keep",
  "version": "1.8.1",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run api\" \"npm run client\"",
    "client": "set NG_SASS_VERBOSE_DEPRECATIONS=0&& ng serve --host 0.0.0.0 --port 6767 --proxy-config proxy.conf.json",
    "api": "nodemon --no-deprecation server/server.js",
    "build": "ng build && npm run purgecss",
    "test:sync": "node server/sync-smoke.test.js",
    "test:native": "node server/native-client.test.js",
    "test:reminders": "node --test server/reminder-recurrence.test.js",
    "mcp": "node mcp/index.mjs",
    "test:mcp": "node --test mcp/*.test.mjs",
    "purgecss": "purgecss -c purgecss.config.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "analyze": "webpack-bundle-analyzer dist/keep/stats.json",
    "docker:deploy": "npx tsx ./deploy-docker-images.ts",
    "test:personal": "node --test test-fixtures/note-contrast.test.cjs test-fixtures/personal-*.test.cjs"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "adm-zip": "^0.6.1",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "multer": "^2.3.0",
    "openid-client": "^6.8.8",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.0",
    "sqlite3": "^6.0.1",
    "unzipper": "^0.12.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.27",
    "@angular/animations": "^21.2.25",
    "@angular/cli": "~21.2.27",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@capacitor/core": "^8.3.4",
    "@popperjs/core": "^2.11.5",
    "@types/jasmine": "~4.0.0",
    "@types/jszip": "^3.4.0",
    "bricks.js": "^1.8.0",
    "concurrently": "^9.2.5",
    "jasmine-core": "~4.1.0",
    "jszip": "^3.10.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "node-snackbar": "^0.1.16",
    "nodemon": "^3.1.9",
    "playwright": "1.62.1",
    "purgecss": "^4.1.3",
    "rxjs": "~7.5.0",
    "selfsigned": "5.5.0",
    "timepicker-ui": "^4.3.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.3",
    "webpack-bundle-analyzer": "^4.6.1",
    "zone.js": "~0.15.1"
  }
}
